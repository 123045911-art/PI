# ==============================================================================
# Visio Flow — Variables de Entorno
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Llena todos los valores marcados con <CAMBIAR>
#   3. NUNCA subas el archivo .env a control de versiones (ya está en .gitignore)
# ==============================================================================

# --- Base de datos PostgreSQL ---
POSTGRES_USER=<CAMBIAR_USUARIO_DB>
POSTGRES_PASSWORD=<CAMBIAR_PASSWORD_SEGURA_MIN16CHARS>
POSTGRES_DB=visio_flow

# --- FastAPI ---
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=<CAMBIAR_SECRETO_JWT_MUY_LARGO>
JWT_EXPIRE_MINUTES=60
APP_ENV=production
# Orígenes CORS separados por coma (sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:8085,http://localhost:5000

# --- Flask ---
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=<CAMBIAR_FLASK_SECRET_KEY>
# Cuenta de servicio para envío de eventos en background (cualquier usuario válido)
API_SERVICE_USERNAME=<CAMBIAR_USUARIO_SERVICIO>
API_SERVICE_PASSWORD=<CAMBIAR_PASSWORD_SERVICIO>
CAMERA_SOURCE=0
CAMERA_DEVICE=/dev/video0

# Protecciones del servidor local de demostracion.
# 80 solicitudes por cliente y 1200 globales dentro de cada ventana de 10 s.
API_RATE_LIMIT_REQUESTS=80
API_GLOBAL_RATE_LIMIT_REQUESTS=1200
API_RATE_LIMIT_WINDOW_SECONDS=10
# La captura fisica es unica; estos valores solo limitan espectadores MJPEG.
MAX_MJPEG_STREAMS=4
MAX_MJPEG_STREAMS_PER_USER=1

# --- Vision, calibracion y escena ---
CAMERA_ID=cam-01
# rgbd | stereo | monocular. Monocular solo proyecta puntos confirmados en el suelo.
SENSOR_MODE=monocular
VISIOFLOW_DATA_DIR=/app/data
VISIOFLOW_START_BACKGROUND=1
# Cambie a 1 inmediatamente si mueve la camara, enfoque u optica; bloquea escaneo.
CALIBRATION_INVALIDATED=0
MIN_DEPTH_METERS=0.20
MAX_DEPTH_METERS=20.0

# ChArUco: todas las longitudes estan en metros.
CHARUCO_DICTIONARY=DICT_5X5_100
CHARUCO_SQUARES_X=7
CHARUCO_SQUARES_Y=5
CHARUCO_SQUARE_LENGTH_METERS=0.04
CHARUCO_MARKER_LENGTH_METERS=0.02
CHARUCO_MIN_CAPTURES=5
MAX_REPROJECTION_ERROR_PX=1.5
MAX_WORLD_VALIDATION_ERROR_METERS=0.15

# Escena fija y agregacion temporal.
SCENE_GRID_RESOLUTION_METERS=0.10
SCAN_FRAME_COUNT=40
SCAN_MIN_DETECTION_RATE=0.65
SCAN_POSITION_TOLERANCE_METERS=0.20
SCAN_DIMENSION_TOLERANCE_METERS=0.25
SCAN_CLUSTER_DISTANCE_METERS=0.50
# Vacio = correccion manual. Debe ser un modelo de segmentacion entrenado para el local.
SCENE_MODEL_PATH=
# Mapa clase-del-modelo -> clase VisioFlow, como objeto JSON en una sola linea.
SCENE_CLASS_MAP={}

# Solo estereo calibrado y rectificado.
STEREO_FOCAL_LENGTH_PX=
STEREO_BASELINE_METERS=

# --- Redis ---
REDIS_PASSWORD=<CAMBIAR_PASSWORD_REDIS>

# --- Laravel ---
# Genera con: php artisan key:generate --show  (dentro del contenedor)
APP_KEY=<CAMBIAR_LARAVEL_APP_KEY>
