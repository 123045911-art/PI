# Por defecto las calibraciones pertenecen a cada instalacion. El preset de
# demostracion de la Dell se versiona para que el pasillo arranque preparado.
contador_personas_flask/data/calibration/*
!contador_personas_flask/data/calibration/dell-wb7022/
!contador_personas_flask/data/calibration/dell-wb7022/*.json
contador_personas_flask/data/scenes/*
!contador_personas_flask/data/scenes/dell-wb7022/
!contador_personas_flask/data/scenes/dell-wb7022/*.json

